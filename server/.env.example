# Copy this file to `.env` (same folder) and fill in YOUR values locally.
# `.env` is git-ignored. Never commit it, paste it into chat, or put these
# values in the Flutter app.

# Firebase project the Flutter web app signs in to (see lib/firebase_options.dart).
# ID tokens from any other project are rejected.
FIREBASE_PROJECT_ID=vanity-tracker

# Gmail account that sends the invitations, and a 16-character Google App Password
# (https://myaccount.google.com/apppasswords - requires 2-Step Verification).
# Do NOT use your normal Gmail password.
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=

# Display name shown in the recipient's inbox.
MAIL_FROM_NAME=Vanity Tracker

# Public web address of the Vanity Tracker web app. Invitation emails show an
# "Open Vanity Tracker" button and a plain-text link to exactly this URL.
# Must be a full http(s) address, e.g. https://your-app.web.app
# Leave empty if the app has no public address yet: emails are then sent WITHOUT a
# link and the server prints a warning (no URL is ever made up).
# A localhost URL only works for people using this laptop.
APP_URL=

# Server binding. 127.0.0.1 keeps the backend reachable only from this laptop.
# Use 0.0.0.0 only if a phone on the same Wi-Fi must reach it.
HOST=127.0.0.1
PORT=8787

# Comma-separated browser origins allowed to call the backend.
# Leave empty to allow any http://localhost:<port> or http://127.0.0.1:<port> origin
# (flutter run -d chrome picks a random port).
ALLOWED_ORIGINS=

# Abuse limits (defaults shown).
MAX_SENDS_PER_USER_PER_HOUR=10
MAX_SENDS_PER_DAY=100
RESEND_COOLDOWN_SECONDS=60
MAX_ATTEMPTS_PER_INVITATION=5
